# Placeholder-only Partner Platform environment template.
# Replace every required placeholder; leave both optional previous-HMAC values blank when unused.
PARTNER_RUNTIME_ID=<kirimkode-partner>
PARTNER_ENVIRONMENT=<development|test|production>
PARTNER_DATABASE_URL=<postgresql-url-ending-in-kirimkode_partner>
PARTNER_SESSION_SECRET=<unique-random-secret-minimum-32-characters>
PARTNER_INTERNAL_API_HMAC_CLIENT_ID=<main-service-client-id>
PARTNER_INTERNAL_API_HMAC_CURRENT_KEY_ID=<current-key-id>
PARTNER_INTERNAL_API_HMAC_CURRENT_SECRET=<unique-random-hmac-secret-minimum-32-characters>
PARTNER_INTERNAL_API_HMAC_PREVIOUS_KEY_ID=<optional-previous-key-id>
PARTNER_INTERNAL_API_HMAC_PREVIOUS_SECRET=<optional-unique-previous-hmac-secret>
PARTNER_DEVICE_CREDENTIAL_PEPPER=<unique-random-device-pepper-minimum-32-characters>
PARTNER_SMS_OTP_ENCRYPTION_KEY_VERSION=<positive-integer-encryption-key-version>
PARTNER_SMS_OTP_ENCRYPTION_KEY=<unique-base64url-encoded-32-byte-key>
PARTNER_CRON_SECRET=<unique-random-cron-secret-minimum-32-characters>
# Where scripts/run-cron.mjs dispatches the background jobs. Defaults to the
# loopback app (http://127.0.0.1:3001) when unset. A non-loopback plain-http
# value is refused, so the cron bearer is never sent in clear text.
PARTNER_CRON_BASE_URL=<optional-http://127.0.0.1:3001-or-https-origin>
PARTNER_SMTP_HOST=<smtp-hostname>
PARTNER_SMTP_PORT=<smtp-port>
PARTNER_SMTP_SECURE=<true|false>
PARTNER_SMTP_USERNAME=<smtp-username>
PARTNER_SMTP_PASSWORD=<smtp-password>
PARTNER_SMTP_FROM=<partner-sender-email>
PARTNER_PORTAL_ORIGIN=<https://partner.kirimkode.com>
PARTNER_API_ORIGIN=<https://partner-api.kirimkode.com>
PARTNER_TRUSTED_PROXIES=<comma-separated-explicit-ip-or-cidr-list>
PARTNER_PORT=<3001>
PARTNER_TIMEZONE=<Asia/Jakarta>
