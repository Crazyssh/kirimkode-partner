{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": ".partner-cache/typescript/tsconfig.tsbuildinfo",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      "@application/*": ["./src/application/*"],
      "@domain/*": ["./src/domain/*"],
      "@infrastructure/*": ["./src/infrastructure/*"],
      "@test/*": ["./src/test/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".partner-next/types/**/*.ts",
    ".partner-next/dev/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "scripts/**/*.mjs"
  ],
  "exclude": ["node_modules", ".partner-next"]
}
